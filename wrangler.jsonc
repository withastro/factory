{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "factory",
	"workers_dev": false,
	"preview_urls": false,
	"compatibility_date": "2026-08-10",
	"compatibility_flags": ["nodejs_compat"],
	"secrets": {
		"required": [
			"GITHUB_APP_ID",
			"GITHUB_APP_PRIVATE_KEY",
			"GITHUB_WEBHOOK_SECRET"
		]
	},
	"ai": {
		"binding": "AI"
	},
	"worker_loaders": [{ "binding": "LOADER" }],
	"r2_buckets": [
		{
			"binding": "PRIVATE_REPORTS",
			"bucket_name": "astro-release-securitybot-reports"
		}
	],
	"vars": {
		"SANDBOX_TRANSPORT": "rpc"
	},
	"containers": [
		{
			"class_name": "Sandbox",
			"image": "./Dockerfile",
			"max_instances": 10,
			"instance_type": "standard-2"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "REVIEW_COORDINATOR",
				"class_name": "ReviewCoordinator"
			},
			{
				"name": "TRIAGE_COORDINATOR",
				"class_name": "TriageCoordinator"
			},
			{
				"name": "TRIAGE_SANDBOX",
				"class_name": "Sandbox"
			},
			{
				"name": "RELEASE_SECURITY_COORDINATOR",
				"class_name": "ReleaseSecurityCoordinator"
			},
			{
				"name": "RELEASE_SECURITY_SANDBOX",
				"class_name": "Sandbox"
			}
		]
	},
	"workflows": [
		{
			"name": "factory-review",
			"binding": "REVIEW_WORKFLOW",
			"class_name": "ReviewWorkflow"
		},
		{
			"name": "factory-triage",
			"binding": "TRIAGE_WORKFLOW",
			"class_name": "TriageWorkflow"
		},
		{
			"name": "factory-release-security",
			"binding": "RELEASE_SECURITY_WORKFLOW",
			"class_name": "ReleaseSecurityWorkflow"
		}
	],
	"observability": {
		"enabled": true,
		"traces": {
			"enabled": true
		},
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"FluePullRequestReviewerAgent",
				"FlueFixVerifierAgent",
				"FlueRetriageJudgeAgent",
				"ReviewCoordinator",
				"TriageCoordinator"
			]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": ["FlueTriagePipelineAgent", "Sandbox"]
		},
		{
			"tag": "v3",
			"new_sqlite_classes": [
				"FlueReleaseSecurityReviewerAgent",
				"ReleaseSecurityCoordinator"
			]
		}
	]
}
