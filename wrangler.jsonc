{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "factory",
	"workers_dev": false,
	"preview_urls": false,
	"compatibility_date": "2026-08-10",
	"compatibility_flags": ["nodejs_compat"],
	"secrets": {
		"required": [
			"GITHUB_APP_ID",
			"GITHUB_APP_PRIVATE_KEY",
			"GITHUB_WEBHOOK_SECRET",
			"FACTORY_AI_GATEWAY_TOKEN",
			"FACTORY_AI_GATEWAY_ACCOUNT_ID",
			"FACTORY_AI_GATEWAY_ID"
		]
	},
	"worker_loaders": [{ "binding": "LOADER" }],
	"r2_buckets": [
		{
			"binding": "PRIVATE_REPORTS",
			"bucket_name": "astro-release-securitybot-reports"
		},
		{
			"binding": "ADVERSARY_ARTIFACTS",
			"bucket_name": "factory-adversary-artifacts"
		}
	],
	"vars": {
		"SANDBOX_TRANSPORT": "rpc",
		"DISCORD_SECURITY_CHANNEL_ID": "1432493454784462970",
		"DISCORD_GUILD_ID": "830184174198718474",
		"DISCORD_ALLOWED_ROLE_IDS": "857704874505535528,857704834597650472",
		"DISCORD_ASSISTANT_CHANNEL_IDS": "",
		"DISCORD_REPOSITORY": "withastro/astro"
	},
	"triggers": { "crons": ["* * * * *"] },
	"containers": [
		{
			"class_name": "Sandbox",
			"image": "./Dockerfile",
			"max_instances": 10,
			"instance_type": "standard-2"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "REVIEW_COORDINATOR",
				"class_name": "ReviewCoordinator"
			},
			{
				"name": "ADVERSARY_COORDINATOR",
				"class_name": "AdversaryCoordinator"
			},
			{
				"name": "ADVERSARY_SANDBOX",
				"class_name": "Sandbox"
			},
			{
				"name": "TRIAGE_COORDINATOR",
				"class_name": "TriageCoordinator"
			},
			{
				"name": "TRIAGE_SANDBOX",
				"class_name": "Sandbox"
			},
			{
				"name": "AUTHOR_COORDINATOR",
				"class_name": "AuthorCoordinator"
			},
			{
				"name": "RELEASE_SECURITY_COORDINATOR",
				"class_name": "ReleaseSecurityCoordinator"
			},
			{
				"name": "RELEASE_SECURITY_SANDBOX",
				"class_name": "Sandbox"
			},
			{
				"name": "ADVISORY_COORDINATOR",
				"class_name": "AdvisoryCoordinator"
			},
			{
				"name": "DISCORD_GATEWAY",
				"class_name": "DiscordGateway"
			},
			{
				"name": "DISCORD_THREAD_COORDINATOR",
				"class_name": "DiscordThreadCoordinator"
			}
		]
	},
	"workflows": [
		{
			"name": "factory-review",
			"binding": "REVIEW_WORKFLOW",
			"class_name": "ReviewWorkflow"
		},
		{
			"name": "factory-adversary",
			"binding": "ADVERSARY_WORKFLOW",
			"class_name": "AdversaryWorkflow"
		},
		{
			"name": "factory-triage",
			"binding": "TRIAGE_WORKFLOW",
			"class_name": "TriageWorkflow"
		},
		{
			"name": "factory-author",
			"binding": "AUTHOR_WORKFLOW",
			"class_name": "AuthorWorkflow"
		},
		{
			"name": "factory-release-security",
			"binding": "RELEASE_SECURITY_WORKFLOW",
			"class_name": "ReleaseSecurityWorkflow"
		},
		{
			"name": "factory-advisory",
			"binding": "ADVISORY_WORKFLOW",
			"class_name": "AdvisoryWorkflow"
		},
		{
			"name": "factory-discord-thread",
			"binding": "DISCORD_THREAD_WORKFLOW",
			"class_name": "DiscordThreadWorkflow"
		}
	],
	"observability": {
		"enabled": true,
		"traces": {
			"enabled": true
		},
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"FluePullRequestReviewerAgent",
				"FlueFixVerifierAgent",
				"FlueRetriageJudgeAgent",
				"ReviewCoordinator",
				"TriageCoordinator"
			]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": ["FlueTriagePipelineAgent", "Sandbox"]
		},
		{
			"tag": "v3",
			"new_sqlite_classes": [
				"FlueReleaseSecurityReviewerAgent",
				"ReleaseSecurityCoordinator"
			]
		},
		{
			"tag": "v4",
			"new_sqlite_classes": [
				"FlueBlueTeamAgent",
				"FluePurpleTeamAgent",
				"AdversaryCoordinator"
			]
		},
		{
			"tag": "v5",
			"new_sqlite_classes": ["FlueCodeAuthorAgent", "AuthorCoordinator"]
		},
		{
			"tag": "v6",
			"new_sqlite_classes": ["FlueAdvisoryTriagerAgent", "AdvisoryCoordinator"]
		},
		{
			"tag": "v7",
			"new_sqlite_classes": [
				"FlueDiscordAssistantAgent",
				"DiscordGateway",
				"DiscordThreadCoordinator"
			]
		},
		{
			"tag": "v8",
			"deleted_classes": [
				"FlueDiscordAssistantAgent",
				"DiscordGateway",
				"DiscordThreadCoordinator"
			]
		},
		{
			"tag": "v9",
			"new_sqlite_classes": [
				"FlueDiscordAssistantAgent",
				"DiscordGateway",
				"DiscordThreadCoordinator"
			]
		}
	]
}
