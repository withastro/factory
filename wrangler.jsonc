{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "astro-review",
	"compatibility_date": "2026-08-10",
	"compatibility_flags": ["nodejs_compat"],
	"secrets": {
		"required": ["GITHUB_APP_ID", "GITHUB_APP_PRIVATE_KEY", "GITHUB_WEBHOOK_SECRET"]
	},
	"ai": {
		"binding": "AI"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "REVIEW_COORDINATOR",
				"class_name": "ReviewCoordinator"
			}
		]
	},
	"workflows": [
		{
			"name": "astro-review",
			"binding": "REVIEW_WORKFLOW",
			"class_name": "ReviewWorkflow"
		}
	],
	"observability": {
		"enabled": true,
		"traces": {
			"enabled": true
		},
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["FluePullRequestReviewerAgent"]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": ["ReviewCoordinator"]
		}
	]
}
